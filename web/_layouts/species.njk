<div class="page">
    <div class="page-content">
        <main id="article">

            <!-- GENERAL INFO -->
            <div id="description-cards" class="flex row gap">
              

 {%- set has_image = species_slug | checkSpeciesImage %}
                {%- if has_image -%}
                    <div id="species-image" class="flex column small-gap">
                    <div class="image-container flex rounded">
                        {% gallery species_slug %}
                    </div>
                </div>

                {%- endif -%}


               

                <div class="flex column expand small-gap">
                    <!-- TAXONOMY CARD-->
                    {{ taxonomy({ species: name, species_slug: species_slug, genus: genus, genus_slug: genus_slug,
                    familia:
                    familia, familia_slug: familia_slug, common_names: common_names, etymology: etymology }) }}

                    <!--<div id="cultivars-card" class="rounded background outline shadow" style="padding: 0.5em;">
                        <p>Cultivars</p>
                        <div id="cultivars" style="display: flex">
                            <ul>
                                <li><p><span id="cultivar-taxon">Angel Snow</span></p></li>
                                <li><p><span id="cultivar-taxon">Black Star</span></p></li>
                            </ul>
                        </div>
                    </div>-->


                    <div id="info-pills" class="flex wrap">
                        <!-- FLOWERING -->
                        {%- if flowering == true -%}
                        <a href="#additional-information">
                            <div
                                style="display: flex; flex-direction: column; align-items: center; justify-content: center;"
                                class="rounded outline foreground">
                                <p style="margin: 0; font-size: 1.0em;">Flowering</p>
                            </div>
                        </a>
                        {%- elseif flowering == false -%}
                        <div
                            style="display: flex; flex-direction: column; align-items: center; justify-content: center;"
                            class="rounded outline background">
                            <p style="margin: 0; font-size: 1.0em;">Non-flowering</p>
                        </div>
                        {%- endif -%}

                        <!-- TOXICITY -->
                        {%- if safe_for_pets == true -%}
                        <a href="#additional-information">
                            <div class="flex always-row align-center justify-center rounded outline background">
                                <p style="margin: 0; font-size: 1.0em;">Safe for pets</p>
                            </div>
                        </a>
                        {%- endif -%}

                        <!-- VULNERABILITY STATUS -->
                        {%- if iucn_status == "near_threatened" -%}
                        <div id="iucn-status" class="tag rounded outline background"
                             style="background-color: #ffdcd4; color: var(--tomato-11); border: 1px solid transparent;">
                            <a href="#additional-information">
                                <p style="margin: 0; font-size: 1.0em;">Near Threatened</p>
                            </a>
                            <div class="tooltip">
                                <svg class="tooltip-icon" style="color: var(--tomato-11);" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                     viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                <span class="tooltiptext">Vulnerability status according to the IUCN Red List of Threatened Species.</span>
                            </div>
                        </div>
                        {%- elseif iucn_status == "vulnerable" -%}
                        <div id="iucn-status" class="tag rounded outline background"
                             style="background-color: #ffdcd4; color: var(--tomato-11); border: 1px solid transparent;">
                            <a href="#additional-information">
                                <p style="margin: 0; font-size: 1.0em;">IUCN Vulnerable</p>
                            </a>
                            <div class="tooltip">
                                <svg class="tooltip-icon" style="color: var(--tomato-11);" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                     viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                <span class="tooltiptext">Vulnerability status according to the IUCN Red List of Threatened Species.</span>
                            </div>
                        </div>
                        {%- elseif iucn_status == "endangered" -%}
                        <div id="iucn-status" class="tag rounded outline background"
                             style="background-color: #ffdcd4; color: var(--tomato-11); border: 1px solid transparent;">
                            <a href="#additional-information">
                                <p style="margin: 0; font-size: 1.0em;">Endangered</p>
                            </a>
                            <div class="tooltip">
                                <svg class="tooltip-icon" style="color: var(--tomato-11);" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                     viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                <span class="tooltiptext">Vulnerability status according to the IUCN Red List of Threatened Species.</span>
                            </div>
                        </div>
                        {%- elseif iucn_status == "critically_endangered" -%}
                        <div id="iucn-status" class="tag rounded outline background"
                             style="background-color: #ffdcd4; color: var(--tomato-11); border: 1px solid transparent;">
                            <a href="#additional-information">
                                <p style="margin: 0; font-size: 1.0em;">Critically Endangered</p>
                            </a>
                            <div class="tooltip">
                                <svg class="tooltip-icon" style="color: var(--tomato-11);" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                     viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                <span class="tooltiptext">Vulnerability status according to the IUCN Red List of Threatened Species.</span>
                            </div>
                        </div>
                        {%- elseif iucn_status == "extinct_in_the_wild" -%}
                        <div id="iucn-status" class="tag rounded outline background"
                             style="background-color: #ffdcd4; color: var(--tomato-11); border: 1px solid transparent;">
                            <a href="#additional-information">
                                <p style="margin: 0; font-size: 1.0em;">Extinct In The Wild</p>
                            </a>
                            <div class="tooltip">
                                <svg class="tooltip-icon" style="color: var(--tomato-11);" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                     viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                <span class="tooltiptext">Vulnerability status according to the IUCN Red List of Threatened Species.</span>
                            </div>
                        </div>
                        {%- elseif iucn_status == "extinct" -%}
                        <div id="iucn-status" class="tag rounded outline background"
                             style="background-color: #c7c7c724; color: #9f9f9f; border: 1px solid transparent;">
                            <a href="#additional-information">
                                <p style="margin: 0; font-size: 1.0em;">Extinct</p>
                            </a>
                            <div class="tooltip">
                                <svg class="tooltip-icon" style="color: #9f9f9f;" aria-hidden="true"
                                     xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none"
                                     viewBox="0 0 24 24">
                                    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"
                                          stroke-width="2"
                                          d="M10 11h2v5m-2 0h4m-2.592-8.5h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
                                </svg>
                                <span class="tooltiptext">Vulnerability status according to the IUCN Red List of Threatened Species.</span>
                            </div>
                        </div>
                        {%- else -%}
                        {%- endif -%}
                    </div>
                </div>


            </div>

            <!-- DISTRIBUTION -->
            {%- if (native | length > 0) or (introduced | length > 0) -%}
            <section id="distribution">
                <h2 id="distribution-header" class="flex align-center">
                    <a href="#distribution"><img class="header-icon" src="/web/assets/icons/globe.svg"
                                                 alt="Globe icon"/></a>
                    Distribution
                </h2>

                <div class="flex row">
                    {%- if (native | length > 0) or (introduced | length > 0) -%}

                    <div class="flex column" style="flex-basis: 40%">
                        {%- if (native | zonecount < 2) -%}
                        <p>{{ name }} is native to the {{ native }} region, thriving naturally in this area.</p>
                        {%- else -%}
                        <p>{{ name }} is native to regions including {{ native | formatRegions }}, thriving naturally in these
                            areas.</p>
                        {%- endif -%}

                        {%- if introduced | length > 0 -%}
                        <p>It has also been introduced to regions such as {{ introduced | formatRegions }}, adapting well to diverse
                            environments globally.</p>
                        {%- endif -%}
                    </div>

                    <!-- MAP -->
                  {{ { native: native, introduced: introduced } | inlineGeoJSON(species_slug) | safe }}

                    {{ map({ species_slug: species_slug }) }}




                    {%- else -%}

                    {{ noinfo({ text: "distribution data" }) }}

                    {%- endif -%}
                </div>
            </section>
            {%- endif -%}

            <!-- CARE -->
            <section id="care">
                <h2 id="care-header" class="flex align-center">
                    <a href="#care"><img class="header-icon" src="/web/assets/icons/care.svg"
                                         alt="Care icon"/></a>
                    Care
                </h2>
                <p>Learn how to care for {{ name }} when keeping it indoors.</p>
                <p>Each topic has an
                    in-depth guide that you may read to get more information.</p>

                <div id="care-cards">

                    <!-- LIGHT -->
                    {%- if min_light and max_light -%}
                    <div class="outline rounded care-card">
                        <details>
                            <summary class="flex space-between align-center">
                                <h3 id="light" class="p-0">Light</h3>
                                <img class="header-icon icon-plus" src="/web/assets/icons/plus.svg" alt="Plus icon"/>
                                <img class="header-icon icon-minus" src="/web/assets/icons/minus.svg"
                                     alt="Minus icon"/>
                            </summary>

                            <div>
                                {%- if min_light or max_light -%}

                                {{ noinfo({ text: "light information" }) }}

                                {%- else -%}
                                <p>Place your {{ name }} in an area matching the following characteristics.</p>
                                <div class="enumeration">
                                    <ul>
                                        {%- if (min_light + max_light) * 0.5 < 1 -%}
                                        <li class="background rounded outline"><p>low light</p></li>
                                        <li class="background rounded outline"><p>shaded</p></li>
                                        <li class="background rounded outline"><p>north-facing window</p></li>
                                        {%- elseif (min_light + max_light) * 0.5 > 1 and (min_light + max_light) * 0.5 <
                                        4 -%}
                                        <li class="background rounded outline"><p>indirect sunlight</p></li>
                                        <li class="background rounded outline"><p>east-facing window</p></li>
                                        <li class="background rounded outline"><p>west-facing window</p></li>
                                        {%- elseif (min_light + max_light) * 0.5 > 4 and (min_light + max_light) * 0.5 <
                                        20 -%}
                                        <li class="background rounded outline"><p>bright, indirect sunlight</p></li>
                                        <li class="background rounded outline"><p>filtered sunlight</p></li>
                                        <li class="background rounded outline"><p>east or west facing window</p></li>
                                        {%- elseif (min_light + max_light) * 0.5 > 20 -%}
                                        <li class="background rounded outline"><p>bright light</p></li>
                                        <li class="background rounded outline"><p>direct sunlight</p></li>
                                        <li class="background rounded outline"><p>south-facing window</p></li>
                                        {%- endif -%}
                                    </ul>
                                </div>

                                <p>{{ name }} prefers light intensities between {{ min_light * 1000 }} lux
                                    and {{ max_light * 1000 }} lux. It may also survive in light intensities as low
                                    as {{ min_light * 1000 * 0.5 }} lux.</p>


