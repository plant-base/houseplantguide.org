                                             style="width: calc(({{ max_humidity }} - {{ min_humidity }}) / 100 * 100%); left: calc({{ min_humidity }} / 100 * 100%);">
                                        </div>
                                    </div>
                                    <div class="indicator"
                                         style="width: calc(({{ max_humidity }} - {{ min_humidity }}) / 100 * 100%); left: calc({{ min_humidity }} / 100 * 100%);">
                                        <p>{{ min_humidity }}% - {{ max_humidity }}%</p>
                                    </div>
                                </div>


                                <p>Watering or misting your plants will increase the relative humidity around them.</p>
                            </div>

                            {# <div>
                                <p class="more-info"><a href="../../posts/humidity" target="_blank">More information</a>
                                </p>
                            </div> #}

                        </div>
                    {%- endif -%}
