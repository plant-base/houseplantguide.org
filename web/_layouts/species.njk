<script>
    let slideIndex = 1;
    showSlides(slideIndex);

    // Next/previous controls
    function plusSlides(n) {
        showSlides(slideIndex += n);
    }

    // Thumbnail image controls
    function currentSlide(n) {
        showSlides(slideIndex = n);
    }

    function showSlides(n) {
        let i;
        let slides = document.getElementsByClassName("slide");
        if (n > slides.length) {slideIndex = 1}
        if (n < 1) {slideIndex = slides.length}
        for (i = 0; i < slides.length; i++) {
            slides[i].style.display = "none";
        }
        slides[slideIndex-1].style.display = "flex";
    }
</script>



<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{ name }} Care Guide",
  "url": "https://houseplantguide.org/species/{{ species_slug }}/",
  "description": "Learn how to take care of {{ name }} — light, water, soil, temperature, toxicity, and more.",
  "mainEntity": {
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What genus does {{ name }} belong to?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ name }} belongs to the {{ genus }} genus."
        }
      },
      {
        "@type": "Question",
        "name": "What family does {{ name }} belong to?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ name }} belongs to the {{ familia }} family."
        }
      }
      {% if common_names %},
      {
        "@type": "Question",
        "name": "What is {{ name }} commonly called?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ name }} is commonly called {{ common_names }}."
        }
      }
      {% endif %}
      {% if native %},
      {
        "@type": "Question",
        "name": "Where does {{ name }} natively grow?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ name }} grows natively in {{ native }}."
        }
      }
      {% endif %}
      {% if etymology %},
      {
        "@type": "Question",
        "name": "Where does the name of {{ name }} come from?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ etymology }}"
        }
      }
      {% endif %}
      {% if safe_for_pets %},
      {
        "@type": "Question",
        "name": "Is {{ name }} safe for pets?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "{{ name }} is safe for pets."
        }
      }
      {% endif %}
    ]
  }
}
</script>
