                    <!-- HUMIDITY -->
                    {%- if min_humidity and max_humidity -%}
                        <div class="outline rounded care-card">
                            <h3 id="humidity" class="p-0">Humidity</h3>

                            <div>
                                {%- if 0.5 * (min_humidity + max_humidity) < 30 -%}
                                <p>{{ name }} prefers a <span class="emphasize">low relative humidity</span>, ranging
                                    between
                                    {{ min_humidity }}%
                                    and {{ max_humidity }}%.</p>
                                {%- elseif 0.5 * (min_humidity + max_humidity) >= 30 and 0.5 * (min_humidity +
                                max_humidity) <
                                50 -%}
                                <p>{{ name }} prefers a <span class="emphasize">medium relative humidity</span>,
                                    ranging
                                    between {{ min_humidity }}%
                                    and {{ max_humidity }}%.</p>
                                {%- elseif 0.5 * (min_humidity + max_humidity) >= 50 and 0.5 * (min_humidity +
                                max_humidity) <
                                100 -%}
                                <p>{{ name }} prefers a <span class="emphasize">high relative humidity</span>,
                                    ranging
                                    between {{ min_humidity }}%
                                    and {{ max_humidity }}%.</p>
                                {%- endif -%}
                                <div class="value-range">
                                    <div class="bar outline rounded">
                                        <div class="value-label-6">0%</div>
                                        <div class="value-label-6">20%</div>
                                        <div class="value-label-6">40%</div>
                                        <div class="value-label-6">60%</div>
                                        <div class="value-label-6">80%</div>
                                        <div class="value-label-6">100%</div>
