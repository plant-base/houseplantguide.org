---
layout: base.njk
index: true
eleventyComputed:
    icon: 🌱
    title: "{{ name }}{% if common_names %} ({{ common_names }}){% endif %}"
    species_slug: "{{ name | slug }}"
    genus_slug: "{{ genus | slug }}"
    familia_slug: "{{ familia | slug }}"
    permalink: /species/{{ species_slug }}/
    description: "{{ name }} is a {% if flowering %}flowering{% endif %} plant from the {{ familia }} family. Learn how to care for your {{ name }} — find care tips about light, water, soil, temperature, toxicity & more."
---

{%- from "components/taxonomy.njk" import taxonomy -%}
{%- from "components/ph.njk" import ph -%}
{%- from "components/map.njk" import map -%}
{%- from "components/noinfo.njk" import noinfo -%}

<!-- PAGEFIND EXCERPT -->
<span style="display: none" data-pagefind-meta="title">{{ name }}</span>
{%- if common_names -%}
<span style="display: none" data-pagefind-body>{{ name }} is also known as {{ common_names }}.</span>
{%- else -%}
<span style="display: none" data-pagefind-body>{{ name }}.</span>
{%- endif -%}
<span style="display: none" data-pagefind-filter="filter">Species</span>


